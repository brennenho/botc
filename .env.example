# Use credentials for the matching Supabase project or preview branch.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

# PostHog analytics, error tracking, and structured logs.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Keep development traffic out of production analytics by default.
NEXT_PUBLIC_POSTHOG_CAPTURE_IN_DEVELOPMENT="false"
# Emergency/test kill switch. Production deployments normally leave this false.
NEXT_PUBLIC_POSTHOG_DISABLED="false"

# Optional but recommended in production for readable client stack traces.
# POSTHOG_API_KEY is server-only and must have error-tracking write access.
POSTHOG_API_KEY=""
POSTHOG_CLI_HOST="https://us.posthog.com"
POSTHOG_PROJECT_ID=""
