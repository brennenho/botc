{
  "name": "botc",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "dev": "next dev --turbo",
    "dev:integration": "next dev --turbo --hostname localhost --port 3100",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "next start",
    "start:integration": "next start --hostname localhost --port 3100",
    "supabase:lint": "supabase db lint --local --fail-on error",
    "supabase:reset": "supabase db reset",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop",
    "sync:assets": "node scripts/sync-assets.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "supabase test db",
    "test:integration": "playwright test",
    "test:integration:chromium": "playwright test --project=chromium --project=tablet-landscape",
    "test:integration:webkit": "playwright test --project=mobile-webkit",
    "test:integration:smoke": "playwright test --grep @smoke",
    "test:integration:report": "playwright show-report integration-report",
    "test:integration:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/commissioner": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/commissioner": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@posthog/nextjs-config": "^1.12.2",
    "@supabase/supabase-js": "^2.119.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.78.0",
    "next": "^15.5.29",
    "posthog-js": "^1.454.2",
    "posthog-node": "^5.74.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^30.1.3",
    "postcss": "8.5.23",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "supabase": "2.114.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.2.4",
    "vitest": "^4.1.12"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.6",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "sharp": "0.35.0",
      "sharp@<0.35.4": ">=0.35.4",
      "fast-uri@>=3.0.0 <3.1.7": ">=3.1.7",
      "fast-uri@=3.1.6": ">=3.1.7",
      "fast-uri@>=3.0.0 <3.1.8": ">=3.1.8",
      "sharp@<0.35.5": ">=0.35.5",
      "vite@>=8.2.0 <=8.2.3": ">=8.2.4",
      "zod@<4.6.6": ">=4.6.6",
      "fast-uri@>=3.0.0 <3.1.9": ">=3.1.9",
      "fast-uri@>=3.1.3 <3.1.9": ">=3.1.9"
    }
  },
  "packageManager": "pnpm@9.12.2"
}
